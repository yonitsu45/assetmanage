# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=asset
DB_PASSWORD=change-me
DB_NAME=asset_management

# Session
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-hex-string
SESSION_EXPIRY=86400000

# Server
PORT=3000
# Bind address. Use 127.0.0.1 when behind nginx (production), 0.0.0.0 for local dev.
HOST=127.0.0.1

# Uploads
UPLOAD_MAX_SIZE=10485760

# Security
# Set to false to disable the public registration page (production).
ALLOW_REGISTRATION=false
# Set to true when serving over HTTPS (production behind nginx with certbot).
COOKIE_SECURE=true
