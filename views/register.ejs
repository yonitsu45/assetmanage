<%- include('partials/header') %>
<%- include('partials/navbar') %>

<% if (typeof RECAPTCHA_SITE_KEY !== 'undefined' && RECAPTCHA_SITE_KEY) { %>
<script src="https://www.google.com/recaptcha/api.js?render=<%= RECAPTCHA_SITE_KEY %>"></script>
<% } %>

<div class="container">
  <div class="row justify-content-center mt-5">
    <div class="col-md-5">
      <div class="card shadow">
        <div class="card-body p-4">
          <h3 class="card-title text-center mb-4"><%= __('auth.register_title') %></h3>
          <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>
          <form action="/register" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label class="form-label"><%= __('auth.department') %></label>
              <select name="department" class="form-select">
                <option value=""><%= __('auth.select_dept') %></option>
                <% (departments || []).forEach(function(d) { %>
                  <option value="<%= d.name %>"><%= d.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= __('auth.full_name') %> *</label>
              <input type="text" name="full_name" class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= __('auth.username') %> *</label>
              <input type="text" name="username" class="form-control" required pattern="[a-zA-Z0-9_-]+" title="Letters, numbers, underscores, and dashes only">
            </div>
            <div class="mb-3">
              <label class="form-label"><%= __('auth.email') %> *</label>
              <input type="email" name="email" class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= __('auth.password') %> *</label>
              <input type="password" name="password" class="form-control" required minlength="8">
              <div class="form-text"><%= __('auth.error_password_complexity') %></div>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= __('auth.confirm_password') %> *</label>
              <input type="password" name="confirm_password" class="form-control" required>
            </div>
            <input type="hidden" name="g-recaptcha-response" id="recaptchaToken">
            <button type="submit" class="btn btn-primary w-100"><%= __('auth.register_btn') %></button>
          </form>
          <p class="text-center mt-3 mb-0">
            <%= __('auth.has_account') %> <a href="/login"><%= __('auth.login_btn') %></a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (typeof RECAPTCHA_SITE_KEY !== 'undefined' && RECAPTCHA_SITE_KEY) { %>
<script>
document.querySelector('form[action="/register"]').addEventListener('submit', function(e) {
  e.preventDefault();
  var btn = this.querySelector('button[type="submit"]');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>...';
  var form = this;
  grecaptcha.ready(function() {
    grecaptcha.execute('<%= RECAPTCHA_SITE_KEY %>', {action: 'register'}).then(function(token) {
      form.querySelector('#recaptchaToken').value = token;
      form.submit();
    });
  });
});
</script>
<% } %>

<%- include('partials/footer') %>
