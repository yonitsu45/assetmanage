<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="d-flex position-relative">
  <%- include('partials/sidebar') %>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <div class="main-content flex-grow-1 p-4">
    <h4 class="mb-4"><i class="bi bi-people me-2"></i><%= __('admin.title') %></h4>

    <% if (reqQuery.success === 'updated') { %>
      <div class="alert alert-success"><%= __('admin.success_updated') %></div>
    <% } else if (reqQuery.success === 'password_changed') { %>
      <div class="alert alert-success"><%= __('admin.success_password') %></div>
    <% } else if (reqQuery.success === 'user_deleted') { %>
      <div class="alert alert-success"><%= __('admin.success_deleted') %></div>
    <% } else if (reqQuery.success === 'dept_added') { %>
      <div class="alert alert-success"><%= __('admin.success_dept_added') %></div>
    <% } else if (reqQuery.success === 'dept_deleted') { %>
      <div class="alert alert-success"><%= __('admin.success_dept_deleted') %></div>
    <% } else if (reqQuery.success === 'dept_imported') { %>
      <div class="alert alert-success"><%= __('admin.success_dept_imported', reqQuery.inserted || 0, reqQuery.updated || 0, reqQuery.skippedRows || 0, reqQuery.skippedSheets || 0) %></div>
    <% } else if (reqQuery.error === 'edit_failed') { %>
      <div class="alert alert-danger"><%= __('admin.error_edit_failed') %></div>
    <% } else if (reqQuery.error === 'cannot_change_own_role') { %>
      <div class="alert alert-danger"><%= __('admin.error_cannot_change_own_role') %></div>
    <% } else if (reqQuery.error === 'cannot_delete_self') { %>
      <div class="alert alert-danger"><%= __('admin.error_cannot_delete_self') %></div>
    <% } else if (reqQuery.error === 'wrong_password') { %>
      <div class="alert alert-danger"><%= __('admin.error_wrong_password') %></div>
    <% } else if (reqQuery.error === 'delete_user_failed') { %>
      <div class="alert alert-danger"><%= __('admin.error_delete_user_failed') %></div>
    <% } else if (reqQuery.error === 'password_short') { %>
      <div class="alert alert-warning"><%= __('admin.error_password_short') %></div>
    <% } else if (reqQuery.error === 'password_failed') { %>
      <div class="alert alert-danger"><%= __('admin.error_password_failed') %></div>
    <% } else if (reqQuery.error === 'dept_name_required') { %>
      <div class="alert alert-warning"><%= __('admin.error_dept_name_required') %></div>
    <% } else if (reqQuery.error === 'dept_exists') { %>
      <div class="alert alert-warning"><%= __('admin.error_dept_exists') %></div>
    <% } else if (reqQuery.error === 'dept_add_failed') { %>
      <div class="alert alert-danger"><%= __('admin.error_dept_add_failed') %></div>
    <% } else if (reqQuery.error === 'dept_delete_failed') { %>
      <div class="alert alert-danger"><%= __('admin.error_dept_delete_failed') %></div>
    <% } else if (reqQuery.error === 'dept_costcenter_exists') { %>
      <div class="alert alert-warning"><%= __('admin.error_dept_costcenter_exists') %></div>
    <% } else if (reqQuery.error === 'dept_file_required') { %>
      <div class="alert alert-warning"><%= __('admin.error_dept_file_required') %></div>
    <% } else if (reqQuery.error === 'dept_no_valid_rows') { %>
      <div class="alert alert-warning"><%= __('admin.error_dept_no_valid_rows') %></div>
    <% } else if (reqQuery.error === 'dept_bad_file') { %>
      <div class="alert alert-danger"><%= __('admin.error_dept_bad_file') %></div>
    <% } else if (reqQuery.error === 'dept_file_too_large') { %>
      <div class="alert alert-danger"><%= __('admin.error_dept_file_too_large') %></div>
    <% } else if (reqQuery.error === 'dept_import_failed') { %>
      <div class="alert alert-danger"><%= __('admin.error_dept_import_failed') %></div>
    <% } else if (reqQuery.success === 'cat_added') { %>
      <div class="alert alert-success"><%= __('admin.success_category_added') %></div>
    <% } else if (reqQuery.success === 'cat_deleted') { %>
      <div class="alert alert-success"><%= __('admin.success_category_deleted') %></div>
    <% } else if (reqQuery.success === 'cat_imported') { %>
      <div class="alert alert-success"><%= __('admin.success_category_imported', reqQuery.inserted || 0, reqQuery.updated || 0, reqQuery.skippedRows || 0, reqQuery.skippedSheets || 0) %></div>
    <% } else if (reqQuery.error === 'cat_code_required') { %>
      <div class="alert alert-warning"><%= __('admin.error_category_code_required') %></div>
    <% } else if (reqQuery.error === 'cat_name_required') { %>
      <div class="alert alert-warning"><%= __('admin.error_category_name_required') %></div>
    <% } else if (reqQuery.error === 'cat_exists') { %>
      <div class="alert alert-warning"><%= __('admin.error_category_exists') %></div>
    <% } else if (reqQuery.error === 'cat_code_exists') { %>
      <div class="alert alert-warning"><%= __('admin.error_category_code_exists') %></div>
    <% } else if (reqQuery.error === 'cat_add_failed') { %>
      <div class="alert alert-danger"><%= __('admin.error_category_add_failed') %></div>
    <% } else if (reqQuery.error === 'cat_delete_failed') { %>
      <div class="alert alert-danger"><%= __('admin.error_category_delete_failed') %></div>
    <% } else if (reqQuery.error === 'cat_file_required') { %>
      <div class="alert alert-warning"><%= __('admin.error_category_file_required') %></div>
    <% } else if (reqQuery.error === 'cat_no_valid_rows') { %>
      <div class="alert alert-warning"><%= __('admin.error_category_no_valid_rows') %></div>
    <% } else if (reqQuery.error === 'cat_bad_file') { %>
      <div class="alert alert-danger"><%= __('admin.error_category_bad_file') %></div>
    <% } else if (reqQuery.error === 'cat_file_too_large') { %>
      <div class="alert alert-danger"><%= __('admin.error_category_file_too_large') %></div>
    <% } else if (reqQuery.error === 'cat_import_failed') { %>
      <div class="alert alert-danger"><%= __('admin.error_category_import_failed') %></div>
    <% } %>

    <ul class="nav nav-tabs mb-3" id="adminTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="users-tab" data-bs-toggle="tab" data-bs-target="#usersTab" type="button" role="tab">
          <i class="bi bi-people me-1"></i><%= __('admin.users_tab') %>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="departments-tab" data-bs-toggle="tab" data-bs-target="#departmentsTab" type="button" role="tab">
          <i class="bi bi-building me-1"></i><%= __('admin.departments_tab') %>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="categories-tab" data-bs-toggle="tab" data-bs-target="#categoriesTab" type="button" role="tab">
          <i class="bi bi-tags me-1"></i><%= __('admin.categories_tab') %>
        </button>
      </li>
    </ul>

    <div class="tab-content">
      <!-- Users Tab -->
      <div class="tab-pane fade show active" id="usersTab" role="tabpanel">
        <div class="card shadow-sm">
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover table-striped table-sm align-middle">
                <thead class="table-dark">
                  <tr>
                    <% var cols = [
                      {key:'id', label:__('admin.table.id')},
                      {key:'username', label:__('admin.table.username')},
                      {key:'email', label:__('admin.table.email')},
                      {key:'full_name', label:__('admin.table.full_name')},
                      {key:'role', label:__('admin.table.role')},
                      {key:'department', label:__('admin.table.department')},
                      {key:'created_at', label:__('admin.table.created_at')}
                    ]; %>
                    <% cols.forEach(function(c) {
                      var newOrder = sortBy === c.key && order === 'ASC' ? 'DESC' : 'ASC';
                      var icon = sortBy === c.key ? (order === 'ASC' ? 'bi-sort-up' : 'bi-sort-down') : 'bi-sort';
                    %>
                    <th>
                      <a href="/admin/users?sort_by=<%= c.key %>&order=<%= newOrder %>" class="text-white text-decoration-none">
                        <%= c.label %> <i class="bi <%= icon %>"></i>
                      </a>
                    </th>
                    <% }); %>
                    <th class="text-center" style="min-width:180px;"><i class="bi bi-gear"></i></th>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach(function(u) { %>
                  <% var isSelf = u.id === user.id; %>
                  <tr>
                    <td><%= u.id %></td>
                    <td><%= u.username %></td>
                    <td><%= u.email || '-' %></td>
                    <td><%= u.full_name || '-' %></td>
                    <td><span class="badge <%= u.role === 'super_admin' ? 'bg-danger' : u.role === 'admin' ? 'bg-warning text-dark' : 'bg-secondary' %>"><%= u.role %></span></td>
                    <td><%= u.department || '-' %></td>
                    <td class="small"><%= u.created_at ? new Date(u.created_at).toLocaleDateString() : '-' %></td>
                    <td class="text-center">
                      <button class="btn btn-sm btn-outline-primary edit-user-btn" title="<%= __('common.edit') %>"
                        data-id="<%= u.id %>"
                        data-username="<%= u.username %>"
                        data-email="<%= u.email || '' %>"
                        data-full_name="<%= u.full_name || '' %>"
                        data-role="<%= u.role %>"
                        data-department="<%= u.department || '' %>"
                        data-self="<%= isSelf ? 'true' : 'false' %>"
                        data-bs-toggle="modal" data-bs-target="#editUserModal">
                        <i class="bi bi-pencil"></i>
                      </button>
                      <button class="btn btn-sm btn-outline-warning password-user-btn" title="<%= __('admin.password_modal.change') %>"
                        data-id="<%= u.id %>"
                        data-username="<%= u.username %>"
                        data-bs-toggle="modal" data-bs-target="#passwordModal">
                        <i class="bi bi-key"></i>
                      </button>
                      <% if (!isSelf) { %>
                      <button class="btn btn-sm btn-outline-danger delete-user-btn" title="<%= __('common.delete') %>"
                        data-id="<%= u.id %>"
                        data-username="<%= u.username %>"
                        data-bs-toggle="modal" data-bs-target="#deleteUserModal">
                        <i class="bi bi-trash"></i>
                      </button>
                      <% } %>
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Departments Tab -->
      <div class="tab-pane fade" id="departmentsTab" role="tabpanel">
        <div class="card shadow-sm mb-3">
          <div class="card-body">
            <h5 class="card-title mb-1"><i class="bi bi-file-earmark-excel me-1"></i><%= __('admin.import_dept') %></h5>
            <p class="text-muted small mb-2"><%= __('admin.import_dept_hint') %></p>
            <form action="/admin/departments/import" method="POST" enctype="multipart/form-data">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="input-group">
                <input type="file" name="file" class="form-control" accept=".xlsx,.xls" required>
                <button type="submit" class="btn btn-success"><i class="bi bi-upload me-1"></i><%= __('admin.import_dept_btn') %></button>
              </div>
            </form>
          </div>
        </div>
        <div class="row">
          <div class="col-md-6">
            <div class="card shadow-sm">
              <div class="card-body">
                <h5 class="card-title mb-3"><i class="bi bi-building-add me-1"></i><%= __('admin.add_dept') %></h5>
                <form action="/admin/departments/add" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="mb-2">
                    <label class="form-label small fw-bold mb-1"><%= __('admin.dept_costcenter') %></label>
                    <input type="text" name="costcenter" class="form-control" placeholder="<%= __('admin.dept_costcenter_placeholder') %>">
                  </div>
                  <div class="input-group">
                    <input type="text" name="name" class="form-control" placeholder="<%= __('admin.dept_name') %>" required>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i><%= __('admin.add_dept_btn') %></button>
                  </div>
                </form>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card shadow-sm">
              <div class="card-body">
                <h5 class="card-title mb-3"><i class="bi bi-list me-1"></i><%= __('admin.departments_tab') %></h5>
                <% if (departments.length === 0) { %>
                  <p class="text-muted mb-0"><%= __('admin.no_departments') %></p>
                <% } else { %>
                  <div class="table-responsive dept-scroll">
                    <table class="table table-sm table-hover align-middle">
                      <thead class="table-light">
                        <tr>
                          <th><%= __('admin.dept_costcenter') %></th>
                          <th><%= __('admin.dept_name') %></th>
                          <th><%= __('admin.table.created_at') %></th>
                          <th class="text-center"><%= __('common.delete') %></th>
                        </tr>
                      </thead>
                      <tbody>
                        <% departments.forEach(function(d) { %>
                        <tr>
                          <td><%= d.costcenter || '-' %></td>
                          <td><%= d.name %></td>
                          <td class="small"><%= d.created_at ? new Date(d.created_at).toLocaleDateString() : '-' %></td>
                          <td class="text-center">
                            <form action="/admin/departments/delete/<%= d.id %>" method="POST" class="d-inline" data-confirm="<%= __('admin.delete_dept_confirm', d.name) %>">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                          </td>
                        </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Categories Tab -->
      <div class="tab-pane fade" id="categoriesTab" role="tabpanel">
        <div class="card shadow-sm mb-3">
          <div class="card-body">
            <h5 class="card-title mb-1"><i class="bi bi-file-earmark-excel me-1"></i><%= __('admin.import_category') %></h5>
            <p class="text-muted small mb-2"><%= __('admin.import_category_hint') %></p>
            <form action="/admin/categories/import" method="POST" enctype="multipart/form-data">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="input-group">
                <input type="file" name="file" class="form-control" accept=".xlsx,.xls" required>
                <button type="submit" class="btn btn-success"><i class="bi bi-upload me-1"></i><%= __('admin.import_category_btn') %></button>
              </div>
            </form>
          </div>
        </div>
        <div class="row">
          <div class="col-md-6">
            <div class="card shadow-sm">
              <div class="card-body">
                <h5 class="card-title mb-3"><i class="bi bi-tags me-1"></i><%= __('admin.add_category') %></h5>
                <form action="/admin/categories/add" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="input-group mb-2">
                    <input type="text" name="code" class="form-control" placeholder="CATEGORY (code)" required>
                  </div>
                  <div class="input-group">
                    <input type="text" name="name" class="form-control" placeholder="Category Name" required>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i><%= __('admin.add_category_btn') %></button>
                  </div>
                </form>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card shadow-sm">
              <div class="card-body">
                <h5 class="card-title mb-3"><i class="bi bi-list me-1"></i><%= __('admin.categories_tab') %></h5>
                <% if (categories.length === 0) { %>
                  <p class="text-muted mb-0"><%= __('admin.no_categories') %></p>
                <% } else { %>
                  <div class="table-responsive dept-scroll">
                    <table class="table table-sm table-hover align-middle">
                      <thead class="table-light">
                        <tr>
                          <th>CATEGORY</th>
                          <th>Category Name</th>
                          <th><%= __('admin.table.created_at') %></th>
                          <th class="text-center"><%= __('common.delete') %></th>
                        </tr>
                      </thead>
                      <tbody>
                        <% categories.forEach(function(c) { %>
                        <tr>
                          <td><%= c.code || '-' %></td>
                          <td><%= c.name %></td>
                          <td class="small"><%= c.created_at ? new Date(c.created_at).toLocaleDateString() : '-' %></td>
                          <td class="text-center">
                            <form action="/admin/categories/delete/<%= c.id %>" method="POST" class="d-inline" data-confirm="<%= __('admin.delete_category_confirm', c.name) %>">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                          </td>
                        </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" id="editUserForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-pencil me-2"></i><%= __('admin.edit_modal.title') %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-bold"><%= __('admin.table.username') %></label>
            <input name="username" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold"><%= __('admin.table.email') %></label>
            <input name="email" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold"><%= __('admin.table.full_name') %></label>
            <input name="full_name" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold"><%= __('admin.table.role') %></label>
            <select name="role" class="form-select" id="editRoleSelect">
              <option value="user">user</option>
              <option value="admin">admin</option>
              <option value="super_admin">super_admin</option>
            </select>
            <small class="text-muted d-none" id="roleLockHint"><i class="bi bi-lock me-1"></i><%= __('admin.edit_modal.role_hint') %></small>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold"><%= __('admin.table.department') %></label>
            <select name="department" class="form-select" id="editDeptSelect">
              <option value=""><%= __('auth.select_dept') %></option>
              <% (departments || []).forEach(function(d) { %>
                <option value="<%= d.name %>"><%= d.name %></option>
              <% }); %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('admin.edit_modal.cancel') %></button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i><%= __('admin.edit_modal.save') %></button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Password Modal -->
<div class="modal fade" id="passwordModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" id="passwordForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-key me-2"></i><%= __('admin.password_modal.title') %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted small"><%= __('admin.password_modal.title') %>: <strong id="passwordUserLabel"></strong></p>
          <div class="mb-3">
            <label class="form-label fw-bold"><%= __('admin.password_modal.new_password') %></label>
            <input name="new_password" type="password" class="form-control" minlength="6" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('admin.password_modal.cancel') %></button>
          <button type="submit" class="btn btn-warning"><i class="bi bi-key me-1"></i><%= __('admin.password_modal.change') %></button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Delete User Modal -->
<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" id="deleteUserForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i><%= __('admin.delete_modal.title') %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p><%= __('admin.delete_modal.confirm') %> <strong id="deleteUserLabel"></strong>?</p>
          <div class="alert alert-warning">
            <i class="bi bi-lock me-1"></i><%= __('admin.delete_modal.password_hint') %>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold"><%= __('auth.password') %></label>
            <input name="confirm_password" type="password" class="form-control" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('admin.delete_modal.cancel') %></button>
          <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i><%= __('admin.delete_modal.delete') %></button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const editModal = document.getElementById('editUserModal');
  editModal.addEventListener('show.bs.modal', function(event) {
    const btn = event.relatedTarget;
    const form = this.querySelector('#editUserForm');
    const isSelf = btn.getAttribute('data-self') === 'true';
    const roleSelect = form.querySelector('#editRoleSelect');
    const roleLockHint = form.querySelector('#roleLockHint');

    ['id','username','email','full_name','role','department'].forEach(function(f) {
      const val = btn.getAttribute('data-' + f) || '';
      const el = form.querySelector('[name="' + f + '"]');
      if (el) el.value = val;
    });

    if (isSelf) {
      roleSelect.disabled = true;
      roleLockHint.classList.remove('d-none');
    } else {
      roleSelect.disabled = false;
      roleLockHint.classList.add('d-none');
    }

    form.setAttribute('action', '/admin/users/edit/' + btn.getAttribute('data-id'));
  });

  const pwModal = document.getElementById('passwordModal');
  pwModal.addEventListener('show.bs.modal', function(event) {
    const btn = event.relatedTarget;
    const form = this.querySelector('#passwordForm');
    form.setAttribute('action', '/admin/users/password/' + btn.getAttribute('data-id'));
    document.getElementById('passwordUserLabel').textContent = btn.getAttribute('data-username');
  });

  const deleteModal = document.getElementById('deleteUserModal');
  deleteModal.addEventListener('show.bs.modal', function(event) {
    const btn = event.relatedTarget;
    const form = this.querySelector('#deleteUserForm');
    form.setAttribute('action', '/admin/users/delete/' + btn.getAttribute('data-id'));
    document.getElementById('deleteUserLabel').textContent = btn.getAttribute('data-username');
  });
});
</script>

