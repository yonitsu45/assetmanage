<%- include('partials/header') %>
<%- include('partials/navbar') %>

<% if (typeof RECAPTCHA_SITE_KEY !== 'undefined' && RECAPTCHA_SITE_KEY) { %>
<script src="https://www.google.com/recaptcha/api.js?render=<%= RECAPTCHA_SITE_KEY %>"></script>
<% } %>

<div class="container">
  <div class="row justify-content-center mt-5">
    <div class="col-md-5">
      <div class="card shadow">
        <div class="card-body p-4">
          <h3 class="card-title text-center mb-4"><%= __('auth.login_title') %></h3>
          <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>
          <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success"><%= success %></div>
          <% } %>
          <% if (query && query.register === 'disabled') { %>
            <div class="alert alert-warning"><%= __('auth.registration_disabled') %></div>
          <% } %>
          <% if (query && query.verify === 'success') { %>
            <div class="alert alert-success"><%= __('auth.email_verified') %></div>
          <% } %>
          <% if (query && query.verify === 'sent') { %>
            <div class="alert alert-info"><%= __('auth.resend_verify_sent') %></div>
          <% } %>
          <% if (query && query.verify === 'invalid') { %>
            <div class="alert alert-danger">Invalid verification link.</div>
          <% } %>
          <% if (query && query.verify === 'already') { %>
            <div class="alert alert-info">Email is already verified. Please log in.</div>
          <% } %>
          <form action="/login" method="POST" autocomplete="off">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label class="form-label"><%= __('auth.username') %></label>
              <input type="text" name="username" class="form-control" required autocomplete="off">
            </div>
            <div class="mb-3">
              <label class="form-label"><%= __('auth.password') %></label>
              <input type="password" name="password" class="form-control" required autocomplete="new-password">
            </div>
            <input type="hidden" name="g-recaptcha-response" id="recaptchaToken">
            <button type="submit" class="btn btn-primary w-100"><%= __('auth.login_btn') %></button>
          </form>

          <% if (typeof unverifiedEmail !== 'undefined' && unverifiedEmail) { %>
          <div class="mt-3 p-3 bg-light rounded">
            <p class="small mb-2"><i class="bi bi-envelope-exclamation me-1"></i><%= __('auth.resend_verify') %>:</p>
            <form action="/resend-verify" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="email" value="<%= unverifiedEmail %>">
              <button type="submit" class="btn btn-outline-warning btn-sm w-100"><i class="bi bi-arrow-repeat me-1"></i><%= __('auth.resend_verify') %></button>
            </form>
          </div>
          <% } %>

          <% if (ALLOW_REGISTRATION) { %>
          <p class="text-center mt-3 mb-0">
            <%= __('auth.no_account') %> <a href="/register"><%= __('auth.register_btn') %></a>
          </p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (typeof RECAPTCHA_SITE_KEY !== 'undefined' && RECAPTCHA_SITE_KEY) { %>
<script>
document.querySelectorAll('form[action="/login"]').forEach(function(form) {
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>...';
    grecaptcha.ready(function() {
      grecaptcha.execute('<%= RECAPTCHA_SITE_KEY %>', {action: 'login'}).then(function(token) {
        form.querySelector('#recaptchaToken').value = token;
        form.submit();
      });
    });
  });
});
</script>
<% } %>

<%- include('partials/footer') %>
