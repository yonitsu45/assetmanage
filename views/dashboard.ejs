<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="d-flex position-relative">
  <%- include('partials/sidebar') %>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <div class="main-content flex-grow-1 p-4">
    <h4 class="mb-4">
      <i class="bi bi-speedometer2 me-2"></i><%= __('dashboard.title') %>
      <% if (user.role === 'super_admin') { %>
      <form action="/clear" method="POST" class="d-inline float-end" data-confirm="<%= __('dashboard.clear_confirm') %>" data-confirm-title="<%= __('dashboard.clear_confirm_title') %>">
        <button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-trash3 me-1"></i><%= __('dashboard.clear_all') %></button>
      </form>
      <% } %>
    </h4>

    <% if (typeof cleared !== 'undefined' && cleared) { %>
      <div class="alert alert-success"><%= __('dashboard.cleared', cleared) %></div>
    <% } %>
    <% if (reqQuery.updated) { %>
      <div class="alert alert-success"><%= __('dashboard.updated') %>: <%= reqQuery.updated %></div>
    <% } %>
    <% if (reqQuery.deleted) { %>
      <div class="alert alert-info"><%= __('dashboard.deleted') %>: <%= reqQuery.deleted %></div>
    <% } %>
    <% if (reqQuery.bulk_status) { %>
      <div class="alert alert-success"><%= __('dashboard.bulk_status_done', reqQuery.bulk_status) %></div>
    <% } %>
    <% if (reqQuery.error === 'permission_denied') { %>
      <div class="alert alert-danger"><%= __('dashboard.permission_denied') %></div>
    <% } else if (reqQuery.error === 'not_found') { %>
      <div class="alert alert-warning"><%= __('dashboard.not_found') %></div>
    <% } else if (reqQuery.error === 'edit_failed') { %>
      <div class="alert alert-danger"><%= __('dashboard.edit_failed') %></div>
    <% } else if (reqQuery.error === 'delete_failed') { %>
      <div class="alert alert-danger"><%= __('dashboard.delete_failed') %></div>
    <% } else if (reqQuery.error === 'no_fields') { %>
      <div class="alert alert-warning"><%= __('dashboard.no_fields') %></div>
    <% } else if (reqQuery.error === 'bulk_no_selection') { %>
      <div class="alert alert-warning"><%= __('dashboard.bulk_status_no_selection') %></div>
    <% } else if (reqQuery.error === 'bulk_no_status') { %>
      <div class="alert alert-warning"><%= __('dashboard.bulk_status_no_status') %></div>
    <% } else if (reqQuery.error === 'bulk_failed') { %>
      <div class="alert alert-danger"><%= __('dashboard.bulk_status_failed') %></div>
    <% } %>

    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card border-primary h-100">
          <div class="card-body text-center">
            <h6 class="card-subtitle text-muted"><%= __('dashboard.total') %> Assets</h6>
            <h2 class="text-primary mb-0"><%= summary.total %></h2>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-success h-100">
          <div class="card-body">
            <h6 class="card-subtitle text-muted"><%= __('dashboard.by_status') %></h6>
            <% summary.byStatus.forEach(function(s) { %>
              <div class="d-flex justify-content-between small">
                <span><%= s.label %></span>
                <span class="badge bg-success mb-1"><%= s.value %></span>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-info h-100">
          <div class="card-body">
            <h6 class="card-subtitle text-muted"><%= __('dashboard.by_category') %></h6>
            <% summary.byCategory.forEach(function(c) { %>
              <div class="d-flex justify-content-between small">
                <span><%= c.label %></span>
                <span class="badge bg-info mb-1"><%= c.value %></span>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-warning h-100">
          <div class="card-body">
            <h6 class="card-subtitle text-muted"><%= __('dashboard.by_department') %></h6>
            <% summary.byDept.forEach(function(d) { %>
              <div class="d-flex justify-content-between small">
                <span><%= d.label %></span>
                <span class="badge bg-warning mb-1"><%= d.value %></span>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-body">
        <form method="GET" action="/" id="filterForm">
          <div class="row g-2 mb-2">
            <div class="col-md-5">
              <div class="input-group">
                <input type="text" name="search" class="form-control" placeholder="<%= __('dashboard.search_placeholder') %>" value="<%= search %>">
                <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
                <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse">
                  <i class="bi bi-funnel"></i> <%= __('dashboard.filter.apply') %>
                </button>
                <% if (search || categories.length > 0 || statuses.length > 0 || departments.length > 0) { %>
                  <a href="/" class="btn btn-outline-danger"><%= __('dashboard.filter.clear') %></a>
                <% } %>
              </div>
            </div>
            <div class="col-md-2 ms-auto">
              <select name="limit" class="form-select" onchange="this.form.submit()">
                <option value="25" <%= limit === 25 ? 'selected' : '' %>>25 <%= __('dashboard.pagination.per_page') %></option>
                <option value="50" <%= limit === 50 ? 'selected' : '' %>>50 <%= __('dashboard.pagination.per_page') %></option>
                <option value="100" <%= limit === 100 ? 'selected' : '' %>>100 <%= __('dashboard.pagination.per_page') %></option>
              </select>
            </div>
          </div>
          <!-- FILTER -->
          <div class="collapse <%= categories.length > 0 || statuses.length > 0 || departments.length > 0 ? 'show' : '' %>" id="filterCollapse">
            <div class="card card-body bg-light mb-2">
              <div class="row g-3">
                <div class="col-md-4">
                  <label class="fw-bold small mb-2"><%= __('dashboard.filter.categories') %></label>
                  <div style="max-height:200px; overflow-y:auto;">
                    <% (allCategories || []).forEach(function(c) { %>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="categories" value="<%= c %>" id="cat_<%= c.replace(/\s+/g,'_') %>" <%= (categories || []).includes(c) ? 'checked' : '' %>>
                        <label class="form-check-label" for="cat_<%= c.replace(/\s+/g,'_') %>"><%= c %></label>
                      </div>
                    <% }); %>
                    <% if (!allCategories || allCategories.length === 0) { %>
                      <span class="text-muted small"><%= __('dashboard.no_data') %></span>
                    <% } %>
                  </div>
                </div>
                <div class="col-md-4">
                  <label class="fw-bold small mb-2"><%= __('dashboard.filter.statuses') %></label>
                  <div style="max-height:200px; overflow-y:auto;">
                    <% (allStatuses || []).forEach(function(s) { %>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="statuses" value="<%= s %>" id="stat_<%= s.replace(/\s+/g,'_') %>" <%= (statuses || []).includes(s) ? 'checked' : '' %>>
                        <label class="form-check-label" for="stat_<%= s.replace(/\s+/g,'_') %>"><%= s %></label>
                      </div>
                    <% }); %>
                    <% if (!allStatuses || allStatuses.length === 0) { %>
                      <span class="text-muted small"><%= __('dashboard.no_data') %></span>
                    <% } %>
                  </div>
                </div>
                <div class="col-md-4">
                  <label class="fw-bold small mb-2"><%= __('dashboard.filter.departments') %></label>
                  <div style="max-height:200px; overflow-y:auto;">
                    <% (allDepartments || []).forEach(function(d) { %>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="departments" value="<%= d %>" id="dept_<%= d.replace(/\s+/g,'_') %>" <%= (departments || []).includes(d) ? 'checked' : '' %>>
                        <label class="form-check-label" for="dept_<%= d.replace(/\s+/g,'_') %>"><%= d %></label>
                      </div>
                    <% }); %>
                    <% if (!allDepartments || allDepartments.length === 0) { %>
                      <span class="text-muted small"><%= __('dashboard.no_data') %></span>
                    <% } %>
                  </div>
                </div>
              </div>
              <div class="mt-2">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-funnel"></i> <%= __('dashboard.filter.apply') %></button>
                <button type="submit" formaction="/export" formmethod="GET" class="btn btn-sm btn-success ms-1"><i class="bi bi-file-earmark-excel me-1"></i> <%= __('dashboard.export_excel') %></button>
              </div>
            </div>
          </div>
        </form>

        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
          <button class="btn btn-sm btn-success" id="btnPrintSelected" disabled>
            <i class="bi bi-printer me-1"></i><%= __('dashboard.qr.print_selected') %> (<span id="selectedCount">0</span>)
          </button>
          <% if (user.role === 'super_admin') { %>
          <div class="d-flex align-items-center gap-2">
            <select class="form-select form-select-sm" id="bulkStatus" style="width:auto;">
              <option value=""><%= __('dashboard.bulk_status_placeholder') %></option>
              <option value="ตัดจำหน่าย">ตัดจำหน่าย</option>
              <option value="ใช้งานได้">ใช้งานได้</option>
              <option value="ชำรุด">ชำรุด</option>
              <option value="ยังไม่เปิดใช้งาน">ยังไม่เปิดใช้งาน</option>
              <option value="ไม่ใช้ในราชการ">ไม่ใช้ในราชการ</option>
            </select>
            <button class="btn btn-sm btn-warning" id="btnBulkStatus" disabled>
              <i class="bi bi-arrow-repeat me-1"></i><%= __('dashboard.bulk_status_apply') %>
            </button>
          </div>
          <% } %>
          <span class="text-muted small"><%= __('dashboard.select_hint') %></span>
        </div>

        <div class="table-responsive">
          <table class="table table-hover table-striped table-sm align-middle table-bordered-columns">
            <thead class="table-dark">
              <tr>
                <th class="text-center" style="width:36px;">
                  <input type="checkbox" class="form-check-input" id="selectAll" title="<%= __('dashboard.select_all') %>">
                </th>
                <% 
                const columns = [
                  {key:'business_unit', label:__('dashboard.table.business_unit')},
                  {key:'asset_id', label:__('dashboard.table.asset_id')},
                  {key:'tag_numbe', label:__('dashboard.table.tag_numbe')},
                  {key:'descr', label:__('dashboard.table.descr')},
                  {key:'descr_long', label:__('dashboard.table.descr_long')},
                  {key:'model', label:__('dashboard.table.model')},
                  {key:'plant', label:__('dashboard.table.plant')},
                  {key:'serial_id', label:__('dashboard.table.serial_id')},
                  {key:'vendor_id', label:__('dashboard.table.vendor_id')},
                  {key:'vendor_name', label:__('dashboard.table.vendor_name')},
                  {key:'deptid', label:__('dashboard.table.deptid')},
                  {key:'dept_name', label:__('dashboard.table.dept_name')},
                  {key:'category', label:__('dashboard.table.category')},
                  {key:'x_asset_status', label:__('dashboard.table.x_asset_status')},
                  {key:'asset_status', label:__('dashboard.table.asset_status')},
                  {key:'x_asset_reason', label:__('dashboard.table.x_asset_reason')},
                  {key:'x_agreement_id', label:__('dashboard.table.x_agreement_id')},
                  {key:'created_at', label:__('dashboard.table.uploaded_at')},
                  {key:'updated_at', label:__('dashboard.table.modified_at')}
                ];
                %>
                <%
                const qsBase = ['search=' + encodeURIComponent(search)];
                (categories || []).forEach(function(c) { qsBase.push('categories=' + encodeURIComponent(c)); });
                (statuses || []).forEach(function(s) { qsBase.push('statuses=' + encodeURIComponent(s)); });
                (departments || []).forEach(function(d) { qsBase.push('departments=' + encodeURIComponent(d)); });
                const qs = qsBase.join('&');
                %>
                <% columns.forEach(function(col) {
                  const newOrder = sortBy === col.key && order === 'ASC' ? 'DESC' : 'ASC';
                  const icon = sortBy === col.key ? (order === 'ASC' ? 'bi-sort-up' : 'bi-sort-down') : 'bi-sort';
                %>
                <th>
                  <a href="/?<%= qs %>&sort_by=<%= col.key %>&order=<%= newOrder %>&page=1&limit=<%= limit %>" class="text-white text-decoration-none">
                    <%= col.label %> <i class="bi <%= icon %>"></i>
                  </a>
                </th>
                <% }); %>
                <th class="text-center" style="min-width:90px;"><i class="bi bi-gear"></i></th>
              </tr>
            </thead>
            <tbody>
              <% if (assets.length === 0) { %>
                <tr><td colspan="21" class="text-center text-muted py-4"><%= __('dashboard.no_data') %></td></tr>
              <% } %>
              <% assets.forEach(function(a) { %>
              <tr class="asset-row"
                data-asset_id="<%= a.asset_id %>"
                data-tag_numbe="<%= a.tag_numbe || '' %>"
                data-descr="<%= a.descr || '' %>"
                data-x_agreement_id="<%= a.x_agreement_id || '' %>"
                data-vendor_name="<%= a.vendor_name || '' %>">
                <td class="text-center">
                  <input type="checkbox" class="form-check-input row-check" data-asset_id="<%= a.asset_id %>">
                </td>
                <td><%= a.business_unit || '-' %></td>
                <td><%= a.asset_id || '-' %></td>
                <td><%= a.tag_numbe || '-' %></td>
                <td><%= a.descr || '-' %></td>
                <td><%= a.descr_long || '-' %></td>
                <td><%= a.model || '-' %></td>
                <td><%= a.plant || '-' %></td>
                <td><%= a.serial_id || '-' %></td>
                <td><%= a.vendor_id || '-' %></td>
                <td><%= a.vendor_name || '-' %></td>
                <td><%= a.deptid || '-' %></td>
                <td><%= a.dept_name || '-' %></td>
                <td><span class="badge bg-secondary"><%= a.category || '-' %></span></td>
                <td><%= a.x_asset_status || '-' %></td>
                <td>
                  <span class="badge <%= (a.asset_status || '').toLowerCase() === 'active' ? 'bg-success' : 'bg-secondary' %>">
                    <%= a.asset_status || '-' %>
                  </span>
                </td>
                <td><%= a.x_asset_reason || '-' %></td>
                <td><%= a.x_agreement_id || '-' %></td>
                <td class="text-nowrap small"><%= a.created_at ? new Date(a.created_at).toLocaleDateString() : '-' %></td>
                <td class="text-nowrap small"><%= a.updated_at ? new Date(a.updated_at).toLocaleDateString() : '-' %></td>
                <td class="text-center">
                  <button class="btn btn-sm btn-outline-success qr-btn" title="<%= __('dashboard.qr.title') %>"
                    data-asset_id="<%= a.asset_id %>"
                    data-tag_numbe="<%= a.tag_numbe || '' %>"
                    data-descr="<%= a.descr || '' %>"
                    data-x_agreement_id="<%= a.x_agreement_id || '' %>"
                    data-vendor_name="<%= a.vendor_name || '' %>"
                    data-bs-toggle="modal" data-bs-target="#qrModal">
                    <i class="bi bi-qr-code"></i>
                  </button>
                  <% if (user.role === 'super_admin') { %>
                  <button class="btn btn-sm btn-outline-primary edit-btn" title="<%= __('dashboard.edit') %>"
                    data-asset_id="<%= a.asset_id %>"
                    data-business_unit="<%= a.business_unit || '' %>"
                    data-tag_numbe="<%= a.tag_numbe || '' %>"
                    data-descr="<%= a.descr || '' %>"
                    data-descr_long="<%= a.descr_long || '' %>"
                    data-model="<%= a.model || '' %>"
                    data-plant="<%= a.plant || '' %>"
                    data-serial_id="<%= a.serial_id || '' %>"
                    data-vendor_id="<%= a.vendor_id || '' %>"
                    data-vendor_name="<%= a.vendor_name || '' %>"
                    data-deptid="<%= a.deptid || '' %>"
                    data-dept_name="<%= a.dept_name || '' %>"
                    data-category="<%= a.category || '' %>"
                    data-x_asset_status="<%= a.x_asset_status || '' %>"
                    data-asset_status="<%= a.asset_status || '' %>"
                    data-x_asset_reason="<%= a.x_asset_reason || '' %>"
                    data-x_agreement_id="<%= a.x_agreement_id || '' %>"
                    data-bs-toggle="modal" data-bs-target="#editModal">
                    <i class="bi bi-pencil"></i>
                  </button>
                  <form action="/delete/<%= encodeURIComponent(a.asset_id) %>" method="POST" class="d-inline" data-confirm="<%= __('dashboard.delete_confirm', a.asset_id) %>">
                    <button class="btn btn-sm btn-outline-danger" title="<%= __('dashboard.delete') %>"><i class="bi bi-trash"></i></button>
                  </form>
                  <% } %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <% if (totalPages > 1) { %>
        <nav>
          <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
              <a class="page-link" href="/?<%= qs %>&sort_by=<%= sortBy %>&order=<%= order %>&page=<%= page - 1 %>&limit=<%= limit %>"><%= __('dashboard.pagination.previous') %></a>
            </li>
            <% for (let p = 1; p <= totalPages; p++) { %>
              <% if (p === page || p === 1 || p === totalPages || Math.abs(p - page) <= 2) { %>
                <li class="page-item <%= p === page ? 'active' : '' %>">
                  <a class="page-link" href="/?<%= qs %>&sort_by=<%= sortBy %>&order=<%= order %>&page=<%= p %>&limit=<%= limit %>"><%= p %></a>
                </li>
              <% } else if (p === page - 3 || p === page + 3) { %>
                <li class="page-item disabled"><span class="page-link">...</span></li>
              <% } %>
            <% } %>
            <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
              <a class="page-link" href="/?<%= qs %>&sort_by=<%= sortBy %>&order=<%= order %>&page=<%= page + 1 %>&limit=<%= limit %>"><%= __('dashboard.pagination.next') %></a>
            </li>
          </ul>
        </nav>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form method="POST" id="editForm">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-pencil me-2"></i><%= __('dashboard.edit') %> Asset</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold small">Asset ID</label>
              <input name="asset_id" class="form-control form-control-sm" readonly>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold small"><%= __('dashboard.table.business_unit') %></label>
              <input name="business_unit" class="form-control form-control-sm">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold small"><%= __('dashboard.table.tag_numbe') %></label>
              <input name="tag_numbe" class="form-control form-control-sm">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold small"><%= __('dashboard.table.model') %></label>
              <input name="model" class="form-control form-control-sm">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold small"><%= __('dashboard.table.descr') %></label>
              <input name="descr" class="form-control form-control-sm">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold small"><%= __('dashboard.table.descr_long') %></label>
              <input name="descr_long" class="form-control form-control-sm">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold small"><%= __('dashboard.table.plant') %></label>
              <input name="plant" class="form-control form-control-sm">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold small"><%= __('dashboard.table.serial_id') %></label>
              <input name="serial_id" class="form-control form-control-sm">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold small"><%= __('dashboard.table.category') %></label>
              <input name="category" class="form-control form-control-sm">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold small"><%= __('dashboard.table.vendor_id') %></label>
              <input name="vendor_id" class="form-control form-control-sm">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold small"><%= __('dashboard.table.vendor_name') %></label>
              <input name="vendor_name" class="form-control form-control-sm">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold small"><%= __('dashboard.table.deptid') %></label>
              <input name="deptid" class="form-control form-control-sm">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold small"><%= __('dashboard.table.dept_name') %></label>
              <input name="dept_name" class="form-control form-control-sm">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold small"><%= __('dashboard.table.x_asset_status') %></label>
              <input name="x_asset_status" class="form-control form-control-sm">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold small"><%= __('dashboard.table.asset_status') %></label>
              <select name="asset_status" class="form-select form-select-sm">
                <option value="">-- Select --</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
                <option value="Disposed">Disposed</option>
                <option value="Under Maintenance">Under Maintenance</option>
                <% (allStatuses || []).forEach(function(s) { %>
                  <option value="<%= s %>"><%= s %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold small"><%= __('dashboard.table.x_asset_reason') %></label>
              <input name="x_asset_reason" class="form-control form-control-sm">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold small"><%= __('dashboard.table.x_agreement_id') %></label>
              <input name="x_agreement_id" class="form-control form-control-sm">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('common.cancel') %></button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i><%= __('common.save') %></button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- QR Modal -->
<div class="modal fade" id="qrModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-qr-code me-2"></i><%= __('dashboard.qr.title') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center">
        <div id="qrContainer" class="d-inline-block p-2 border rounded bg-white"></div>
        <div id="qrAssetId" class="fw-bold mt-2"></div>
        <div id="qrAssetDescr" class="text-muted small"></div>
      </div>
      <div class="modal-footer justify-content-center">
        <a id="qrDownload" class="btn btn-success" download><i class="bi bi-download me-1"></i><%= __('dashboard.qr.download') %></a>
        <button id="qrPrint" class="btn btn-outline-secondary"><i class="bi bi-printer me-1"></i><%= __('dashboard.qr.print') %></button>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const editModal = document.getElementById('editModal');
  editModal.addEventListener('show.bs.modal', function(event) {
    const btn = event.relatedTarget;
    const form = this.querySelector('#editForm');
    const fields = ['asset_id','business_unit','tag_numbe','descr','descr_long','model','plant','serial_id','vendor_id','vendor_name','deptid','dept_name','category','x_asset_status','asset_status','x_asset_reason','x_agreement_id'];
    fields.forEach(function(f) {
      const val = btn.getAttribute('data-' + f) || '';
      const el = form.querySelector('[name="' + f + '"]');
      if (el) el.value = val;
    });
    const action = '/edit/' + encodeURIComponent(btn.getAttribute('data-asset_id'));
    form.setAttribute('action', action);
  });

  const qrModal = document.getElementById('qrModal');
  const qrContainer = document.getElementById('qrContainer');
  const qrDownload = document.getElementById('qrDownload');
  const qrPrint = document.getElementById('qrPrint');

  qrModal.addEventListener('show.bs.modal', function(event) {
    const btn = event.relatedTarget;
    qrModal._qrBtn = btn;
    const assetId = btn.getAttribute('data-asset_id');
    const descr = btn.getAttribute('data-descr') || '';
    document.getElementById('qrAssetId').textContent = assetId;
    document.getElementById('qrAssetDescr').textContent = descr;
    const url = window.location.origin + '/asset/' + encodeURIComponent(assetId);
    renderQR(qrContainer, url, 220);
    qrDownload.setAttribute('download', 'qr-' + assetId + '.gif');
  });

  qrDownload.addEventListener('click', function() {
    if (qrContainer.dataset.qrUrl) qrDownload.setAttribute('href', qrContainer.dataset.qrUrl);
  });

  qrPrint.addEventListener('click', function() {
    const btn = qrModal._qrBtn || {};
    const get = function(k) { return btn.getAttribute ? (btn.getAttribute(k) || '') : ''; };
    printLabel({
      qrUrl: qrContainer.dataset.qrUrl,
      title: get('data-asset_id'),
      tag: get('data-tag_numbe'),
      descr: get('data-descr'),
      agreement: get('data-x_agreement_id'),
      vendor: get('data-vendor_name'),
      labelAgreement: '<%= __('dashboard.table.x_agreement_id') %>',
      labelVendor: '<%= __('dashboard.table.vendor_name') %>'
    });
  });

  const selectAll = document.getElementById('selectAll');
  const rowChecks = Array.prototype.slice.call(document.querySelectorAll('.row-check'));
  const btnPrintSelected = document.getElementById('btnPrintSelected');
  const btnBulkStatus = document.getElementById('btnBulkStatus');
  const bulkStatus = document.getElementById('bulkStatus');
  const selectedCountEl = document.getElementById('selectedCount');
  const labelAgreement = '<%= __('dashboard.table.x_agreement_id') %>';
  const labelVendor = '<%= __('dashboard.table.vendor_name') %>';

  function updateSelected() {
    const n = rowChecks.filter(function(c) { return c.checked; }).length;
    selectedCountEl.textContent = n;
    btnPrintSelected.disabled = n === 0;
    if (btnBulkStatus) btnBulkStatus.disabled = n === 0 || !bulkStatus.value;
  }

  selectAll.addEventListener('change', function() {
    rowChecks.forEach(function(c) { c.checked = selectAll.checked; });
    updateSelected();
  });

  rowChecks.forEach(function(c) { c.addEventListener('change', updateSelected); });

  if (btnBulkStatus) {
    bulkStatus.addEventListener('change', updateSelected);
    btnBulkStatus.addEventListener('click', function() {
      const ids = rowChecks.filter(function(c) { return c.checked; }).map(function(c) { return c.closest('tr').getAttribute('data-asset_id'); });
      if (ids.length === 0 || !bulkStatus.value) return;
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/bulk-status';
      form.dataset.confirm = '<%= __('dashboard.bulk_status_confirm') %>'.replace('%s', ids.length).replace('%s', bulkStatus.value);
      form.dataset.confirmTitle = '<%= __('dashboard.bulk_status_confirm_title') %>';
      ids.forEach(function(id) {
        const inp = document.createElement('input');
        inp.type = 'hidden';
        inp.name = 'asset_ids';
        inp.value = id;
        form.appendChild(inp);
      });
      const statusInput = document.createElement('input');
      statusInput.type = 'hidden';
      statusInput.name = 'status';
      statusInput.value = bulkStatus.value;
      form.appendChild(statusInput);
      document.body.appendChild(form);
      form.submit();
    });
  }

  btnPrintSelected.addEventListener('click', function() {
    const opts = [];
    rowChecks.forEach(function(c) {
      if (!c.checked) return;
      const tr = c.closest('tr');
      const get = function(k) { return tr ? (tr.getAttribute(k) || '') : ''; };
      const assetId = get('data-asset_id');
      opts.push({
        qrUrl: qrDataUrl(window.location.origin + '/asset/' + encodeURIComponent(assetId)),
        title: assetId,
        tag: get('data-tag_numbe'),
        descr: get('data-descr'),
        agreement: get('data-x_agreement_id'),
        vendor: get('data-vendor_name'),
        labelAgreement: labelAgreement,
        labelVendor: labelVendor
      });
    });
    printLabels(opts);
  });
});
</script>

<script src="https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.min.js"></script>
<script src="/js/qr.js"></script>

<%- include('partials/footer') %>
